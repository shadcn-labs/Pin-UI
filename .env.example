# Copy to .env.local for `npm run dev`. On Vercel, set the same three under
# Project Settings → Environment Variables (Production and Preview).
# SUPABASE_PUBLISHABLE_KEY is read on the server only — never prefix it with
# NEXT_PUBLIC_.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

NEXT_PUBLIC_SITE_URL=https://pinui.xyz

# --- Dodo Payments (sponsorships) -------------------------------------------
# Server-only, like the Supabase key: never prefix any of these with NEXT_PUBLIC_.
# Dashboard → Developer → API Keys. Use a TEST key while DODO_PAYMENTS_ENVIRONMENT
# is test_mode; a live key only works with live_mode, and the reverse.
DODO_PAYMENTS_API_KEY=
# Dashboard → Developer → Webhooks → your endpoint → Signing secret (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Anything else, or leaving it out, means test_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# One product per plan, created under Products in the same mode as the key (pdt_...)
DODO_PRODUCT_DIAMOND=
DODO_PRODUCT_GOLD=
DODO_PRODUCT_SUPPORTER=
